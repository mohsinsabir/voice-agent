# =============================================================================
# Phase-aware environment variables
# Phase 1 requires only the CORE section. Later sections become required when
# FEATURE flags / phase enable those integrations (see src/config/env.ts).
# =============================================================================

# --- CORE (Phase 1) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local Docker example:
# DATABASE_URL=postgres://voice:voice@localhost:5432/voice_agent
# Supabase (Session mode pooler or direct): Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xffzulhvfqcigbmbnhcv.supabase.co:5432/postgres
# Prefer Session pooler on IPv4-only networks (copy exact URI from Dashboard → Connect):
# DATABASE_URL=postgresql://postgres.xffzulhvfqcigbmbnhcv:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL_MIGRATE=postgresql://postgres:[YOUR-PASSWORD]@db.xffzulhvfqcigbmbnhcv.supabase.co:5432/postgres

# Seed / single-tenant business (Phase 1)
DEFAULT_BUSINESS_NAME=Bright Smile Dental
DEFAULT_BUSINESS_TIMEZONE=Asia/Karachi
DEFAULT_BUSINESS_ID=

# --- PHASE 2 (Retell + Calendar + mid-call confirm) ---
# RETELL_API_KEY=
# RETELL_AGENT_ID=agent_xxxxxxxx
# RETELL_WEBHOOK_SECRET=
# RETELL_TOOL_SECRET=
# ENABLE_RETELL=false
# Google Calendar (service account — share the calendar with the SA email as "Make changes to events")
# GOOGLE_CALENDAR_ID=primary-or-calendar-email@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_EMAIL=voice-agent@YOUR_PROJECT.iam.gserviceaccount.com
# Paste the JSON private_key value; keep \n escapes or real newlines in quotes:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM_NUMBER=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# HANDOFF_TRANSFER_NUMBER=
# STAFF_ALERT_WEBHOOK_URL=

# --- PHASE 3 (n8n Cloud + HubSpot + dashboard) ---
# ENABLE_N8N=true
# N8N_WEBHOOK_URL=https://softsinc.app.n8n.cloud/webhook/voice-agent-call-completed
# N8N_WEBHOOK_SECRET=change-me-phase-3
# HUBSPOT_ACCESS_TOKEN=
# DASHBOARD_SESSION_SECRET=

# Feature gates (set true as you enter each phase)
ENABLE_RETELL=false
ENABLE_CALENDAR=false
ENABLE_MESSAGING=false
ENABLE_N8N=false
ENABLE_HUBSPOT=false

RETELL_TOOL_SECRET=change-me-phase-2
HANDOFF_TRANSFER_NUMBER=+15555550100
