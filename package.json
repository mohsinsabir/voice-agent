{
  "name": "voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI voice agent for dental appointment booking and lead qualification",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate -f migrate.config.cjs up",
    "migrate:down": "node-pg-migrate -f migrate.config.cjs down",
    "migrate:create": "node-pg-migrate -f migrate.config.cjs create",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "voice-agent",
    "retell",
    "appointments"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
